<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>library</title>
    <link rel="stylesheet" href="/Styles/library.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" 
    rel="stylesheet">
</head>
<!-- style="background-color:#ffe5ec" -->
<body>
    <header>
        <img src="/images/ashalogo.png" width="200pt" height="150pt" alt="Asha Library" style="margin-left:-800pt">
        <h1 class="blink heading">📚Asha Library</h1>
    </header>

<nav class="navContainer">
    <ul>
         <li><a id="dashboardBtn" style="color:black">🏛 Dashboard</a></li>
         <li><a id="categoriesBtn" style="color:black">📚 Book Categories</a></li>
         <li><a href="/rating">⭐ Rate Us</a></li>
          <li><a id="OurLibraryBtn" style="color:black">🏫Our Library</a></li>

        <li class="dropdown">
            <a href="">🛠️Settings</a>
            <ul class="dropdown-menu">
                <li><a id="theme-toggle" style="color:black">🌓Theme</a></li>
                <li><a id="ProfileBtn" style="color:black">👤My Profile</a></li>

                <% if (session?.isAdmin) { %>
                <li><a href="/addbook" style="color:black" id="addbook">✚Add Book</a></li>
                <% } %>

                <li><a href="/libraryloginURL" style="color:black">⬅️Logout</a></li>
            </ul>
        </li>
       

    </ul>

    <div style="text-align: right; margin-top: -50px">
        <h2 style="color:black">👤 <%= session?.username %></h2>
    </div>
</nav>

<div id="dashboard">
    <div class="container">
        <h3 style="color:lightcoral; font-weight: bold;">📊 Dashboard Overview</h3>

        <div class="row" id="dashboardContainer">

            <div class="col-12 col-sm-6 col-md-3 mb-4">
                <div class="dash-card h-100 p-3 text-center">
                    <div class="icon-box">📚</div>
                    <h4>Total Books</h4>
                    <h5><%= totalBooks %></h5>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-md-3 mb-4">
                <div class="dash-card h-100 p-3 text-center">
                    <div class="icon-box">👤</div>
                    <h4>Member ID</h4>
                    <h5><%= session?.memberID %></h5>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-md-3 mb-4">
                <div class="pinned-section">
                    <h4 class="pinned-header">📚 Rented Books</h4>

                    <% if (rentbooks.length === 0 && session?.isAdmin) { %>
                        <p class="text-center text-muted">No Rented books yet</p>
                    <% } else { %>
                        <ul class="book-row">
                             <% rentbooks.forEach(b => { %>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <%= b.book %>
                                    </a>
                                   <span class="pinned-badge">Rented </span>
                                </li>
                                
                            <% }) %>
                           
                        </ul>
                    <% } %>
                </div>
            </div>
           
            
               <div class="col-12 col-sm-6 col-md-3 mb-4" >
                <a href="/rentbook">
                    <div class="dash-card h-100 p-3 text-center">
                      <div class="icon-box">📚</div>
                         <h4>Rent Books</h4>
                    </div>
                </a>
                </div>
           
            <!-- Pinned Books -->
            <div class="col-12 col-sm-6 col-md-3 mb-4">
                <div class="pinned-section">
                    <h4 class="pinned-header">📌 Pinned Books</h4>

                    <% if (pinnedBooks.length === 0 && session?.isAdmin) { %>
                        <p class="text-center text-muted">No pinned books yet</p>
                    <% } else { %>
                        <ul class="book-row">
                           <% pinnedBooks.forEach(b => { %>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                   <a href="<%= b.book_url %>" target="_blank" rel="noopener noreferrer">
                                    <%= b.book_name %>
                                    </a>
                                   <span class="pinned-badge">Pinned</span>
                                </li>
                                
                            <% }) %>
                        </ul>
                    <% } %>
                </div>
            </div>

        </div>
    </div>
</div>

<div id="categories">
    <div class="container">
        <h3 style="color:lightcoral; font-weight: bold;">📚 Book Categories</h3>
        <div class="row" id="bookContainer"></div>
    </div>
</div>

<div id="Profile">
    <h4 style="color: lightcoral;">👤 Profile</h4>

    <div class="profile-card">

        <% if (session?.isAdmin) { %>
            <h2>👤 Admin</h2>
            <p style="color: darkgoldenrod; font-style:italic;">Library Administrator</p>

            <div class="info">
                <p><strong style="color: brown;">Joined:</strong> <%= session?.joinedDate %></p>
                <p><strong style="color: brown;">Library ID:</strong> LIB123</p>
            </div>

        <% } else { %>

            <h2>👤 <%= session?.username %></h2>
            <p style="color: darkgoldenrod; font-style:italic;">Library Member</p>

            <div class="info">
                <p><strong style="color: brown;">Joined:</strong> <%= session?.joinedDate %></p>
                <p><strong style="color: brown;">Member ID:</strong> <%= session?.memberID %></p>
            </div>

        <% } %>

    </div>
</div>
<div id="OurLibrary">
    <div class="container">
        <h3 style="color:lightcoral; font-weight:bold;">🏫 Our Library</h3>

        <% if (Array.isArray(our_library) && our_library.length > 0) { %>

            <div class="row">

                <% our_library.forEach(item => { %>

                <div class="col-12 col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">

                        <div class="card-body d-flex align-items-start" style="background-color: #ffb8c9;">

                            <img src="<%= item.image %>" 
                                alt="<%= item.project %>" 
                                class="img-fluid rounded shadow-sm"
                                style="height:180px; width:120px; object-fit:cover; flex-shrink:0; margin-right:15px;">

                            <div class="flex-grow-1" style="min-width: 0; color: black;">
                                <h6 class="mb-2" style="font-size: 1rem; font-weight:bold; color:brown;">
                                    <%= item.project %>
                                </h6>

                                <p class="mb-1"><%= item.district %></p>
                                <p class="mb-1"><%= item.place %></p>
                            </div>

                        </div>

                        <div class="card-footer bg-white border-top-0 text-center pb-3" style="background-color: #ffb8c9;" >
                            <a href="<%= item.link %>" target="_blank" class="btn btn-sm btn-primary w-75">Visit</a>
                        </div>

                    </div>
                </div>

                <% }) %>

            </div>

        <% } else { %>

            <p class="text-center text-muted mt-4">No books available in Our Library yet.</p>

        <% } %>

    </div>
</div>

<footer>&copy;2025 Library</footer>

<script src="/Scrpit/library.js">
    
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
