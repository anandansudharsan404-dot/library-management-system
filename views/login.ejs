<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Library Login</title>
  <link rel="stylesheet" href="/Styles/login.css">
</head>

<body>
 <header><img src="/images/ashalogo.png" width="200pt" height="150pt" /></header>

 <p><img src="/images/ashartc.png" width="200pt" height="150pt" style="margin-left:400pt"/></p>
 
  <div class="container">
    <div class="login-box">
      <h2>📚 Asha Library Login</h2>


      <form action="/libraryloginURL" method="POST">
        <input type="text" name="username" placeholder="👤 Enter Email or Mobile Number" />
  <div class="password-wrapper">
        <input type="password" name="password" id="password" placeholder="🔒 Enter Password"/>
        <img src="/images/eye open.png" id="togglePassword" class="eye-icon" />
  </div>

        <button type="submit">Login</button>
    
      </form>
      
      <h5>OR</h5>
      <a href="/registration"><button>Register</button></a>
      


      <div class="footer">
        © Library Management System
      </div>
    </div>
  </div>

  <script src="/Scrpit/login.js"></script>
</body>
</html>
