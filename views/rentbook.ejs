<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rent Book</title>
    <link rel="stylesheet" href="/Styles/addbook.css">
</head>
<body>

 <div class="container">   
  <form class="form-box" action="/rentbook" method="POST">
    <h2 class="form-title">📚 Rent Books</h2>

    <div class="form-group">
        <label>Select Category</label>
         <select name="category"  id="category" required>
          <option value="Education">Education</option>
          <option value="Fiction">Fiction</option>
        </select>
    </div>
      
    <div class="form-group" id="educationbook">
        <label>Select Book</label>
           <select name="educationbook">
               <option value="">Select Category</option>
               <option value="Commerce">Commerce</option>
               <option value="Mathematics">Mathematics</option>
               <option value="Physics">Physics</option>               
           </select>
    </div>

     <div class="form-group"   id="fictionbook">
        <label>Select Book</label>
           <select name="fictionbook" >
               <option value="">Select Category</option>
               <option value="Ranthambhore Adventure">Ranthambhore Adventure</option>
               <option value="The Mystery of the Sea">The Mystery of the Sea</option>
               <option value="SCARY STORIES">SCARY STORIES</option>               
           </select> 
     </div>
      
<div class="d-grid">
        <button id="rentBtn" class="submit-btn">Rent Book</button>
      </div>
 
  </form>
  
  <div class="footer" style="color: brown;">
        © Library Management System
      </div>
  </div>
</div>
<script>

     const categorySelect = document.getElementById("category");
     const educationbook = document.getElementById("educationbook");
     const fictionbook = document.getElementById("fictionbook");
     educationbook.style.display = "block";
     fictionbook.style.display = "none";

categorySelect.addEventListener("change", function() {
     const showFor ="Fiction";
      
    if (showFor.includes(this.value)) {
      fictionbook.style.display = "block";
      educationbook.style.display = "none";
    } else {
     fictionbook.style.display = "none";
      educationbook.style.display = "block";
    }
  });


</script>
</body>
</html>