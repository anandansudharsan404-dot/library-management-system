<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiction</title>
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" 
     rel="stylesheet">
    <link rel="stylesheet" href="/Styles/book.css">
    <h2 class="mb-4 text-center">📚 Fiction Books</h2>

</head>
<body style="background-color:#ffe5ec">
    <div class="container mt-4">
    
 <form action="/fiction" method="get" class="mb-4">
        <div class="input-group">
            <input 
                type="text" 
                name="search" 
                class="form-control"
                placeholder="Search book by name..."
               value="<%= search || '' %>"
            >
            <button class="btn btn-primary" type="submit">Search</button>
        </div>
    </form>
     <div class="text-center mb-3">
    <button id="toggleViewBtn" class="btn btn-primary btn-sm">
        Change view
    </button>
</div>

<div class="container-fluid mt-4">
     <div id="bookContainer" class="row">
        <% if (fiction && fiction.length > 0) { %>
            <% fiction.forEach(item => { %>
              <div class="book-item col-md-4 mb-4">
    <div class="card shadow-sm h-100">
        <div class="card-body d-flex align-items-start">
            <img src="<%= item.CoverImage %>" 
                 alt="<%= item.BookName %>" 
                 class="img-fluid rounded shadow-sm" 
                 style="height:180px; width:120px; object-fit:cover; flex-shrink: 0; margin-right:15px;">

            <div class="flex-grow-1" style="min-width: 0;">
                <div class="d-flex justify-content-between align-items-start">
                    <div style="min-width: 0;">
                        <span class="text-muted d-block" style="font-size: 0.7rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;">Book Name</span>
                        <h6 class="mb-1" style="font-size: 0.95rem; font-weight: 600; color: #333; line-height: 1.3; word-wrap: break-word;">
                            <%= item.BookName %>
                        </h6>
                        
                        <span class="text-muted d-block mt-2" style="font-size: 0.7rem; font-weight: bold; text-transform: uppercase;">Author</span>
                        <p class="m-0" style="font-size: 0.85rem; color: #555;">
                            <%= item.Author %>
                        </p>
                    </div>

                    <button 
                        class="btn btn-warning btn-sm pin-btn p-1 ms-2" 
                        data-book-name="<%= item.BookName %>"
                          data-book-link="<%= item.BookLink %>"
                        title="Pin this book"
                        style="line-height: 1; border-radius: 5px; flex-shrink: 0;"
                    >
                        📌Pin
                    </button>
                </div>

                <% const rating = userRatings && userRatings[item.BookName] ? userRatings[item.BookName] : 0; %>
                <div class="rating mt-3" data-book="<%= item.BookName %>">
                    <span data-value="1" class="<%= rating >= 1 ? 'active' : '' %>">★</span>
                    <span data-value="2" class="<%= rating >= 2 ? 'active' : '' %>">★</span>
                    <span data-value="3" class="<%= rating >= 3 ? 'active' : '' %>">★</span>
                    <span data-value="4" class="<%= rating >= 4 ? 'active' : '' %>">★</span>
                    <span data-value="5" class="<%= rating >= 5 ? 'active' : '' %>">★</span>
                </div>
            </div>
        </div>

        <div class="card-footer bg-white border-top-0 text-center pb-3">
            <a href="<%= item.BookLink %>" class="btn btn-sm btn-primary w-75 shadow-sm" style="border-radius: 20px;">Read book</a>
        </div>
    </div>
</div>

            <% }) %>
        <% } else { %>
            <p class="text-center">No fiction books found</p>
        <% } %>
    </div>
</div>
</div>
<a href="/library"><img src="/images/BackButton.gif" alt="BackButton" height="100pt"></a>
<script src="/Scrpit/book.js"></script>

</body>
</html>